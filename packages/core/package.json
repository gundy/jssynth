{
  "name": "@gundy/jssynth-core",
  "version": "0.3.0",
  "description": "Pure DSP sample-playback engine (Mixer, Sample) — no DOM or Web Audio dependency",
  "author": "David Gundersen",
  "license": "MIT",
  "repository": "https://github.com/gundy/jssynth",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

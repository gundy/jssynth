{
  "name": "@gundy/jssynth-web-audio",
  "version": "1.0.0",
  "description": "AudioWorklet runtime for jssynth — runs the Player + Mixer on the audio render thread",
  "author": "David Gundersen",
  "license": "MIT",
  "repository": "https://github.com/gundy/jssynth",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "node scripts/build-worklet.mjs && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gundy/jssynth-core": "workspace:*",
    "@gundy/jssynth-tracker": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
